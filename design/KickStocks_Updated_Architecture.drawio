    <mxGraphModel dx="2575" dy="1318" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =========================\n    %% CLIENT\n    %% =========================\n    subgraph CLIENT[\&quot;👤 CLIENT\&quot;]\n        U[\&quot;👤 User\&quot;]\n        B[\&quot;🌐 Web Browser\&quot;]\n    end\n\n    %% =========================\n    %% FRONTEND\n    %% =========================\n    subgraph FRONTEND[\&quot;🖥️ FRONTEND\&quot;]\n        D[\&quot;📊 Dashboard\&quot;]\n        S[\&quot;🔍 Stock Search\&quot;]\n        MS[\&quot;📈 Market Scanner\&quot;]\n        W[\&quot;⭐ Watchlist\&quot;]\n        A[\&quot;📊 Stock Analysis\&quot;]\n        FP[\&quot;🔮 Forecast Page\&quot;]\n    end\n\n    %% =========================\n    %% BACKEND\n    %% =========================\n    subgraph BACKEND[\&quot;⚙️ BACKEND / API\&quot;]\n        API[\&quot;🔗 REST API\&quot;]\n        FLASK[\&quot;🐍 Flask Server\&quot;]\n    end\n\n    %% =========================\n    %% AI AGENTS\n    %% =========================\n    subgraph AGENTS[\&quot;🤖 ANALYSIS &amp; AI AGENTS\&quot;]\n        MA[\&quot;🧠 Master / Decision Agent\&quot;]\n        TA[\&quot;📉 Technical Analysis Agent\&quot;]\n        NSA[\&quot;📰 News Sentiment Agent\&quot;]\n        MLA[\&quot;🤖 ML Agent\&quot;]\n        FA[\&quot;🔮 Forecast Agent\&quot;]\n    end\n\n    %% =========================\n    %% DATA / ML\n    %% =========================\n    subgraph DATA[\&quot;🗄️ ML &amp; DATA\&quot;]\n        M[\&quot;🧠 ML Prediction Models\&quot;]\n        TM[\&quot;💾 Trained ML Models\&quot;]\n        CSV[\&quot;📄 CSV Datasets\&quot;]\n    end\n\n    %% =========================\n    %% EXTERNAL SERVICES\n    %% =========================\n    subgraph EXTERNAL[\&quot;☁️ EXTERNAL DATA SOURCES\&quot;]\n        YF[\&quot;📈 Yahoo Finance API\&quot;]\n        GN[\&quot;📰 Google News RSS\&quot;]\n    end\n\n    %% =========================\n    %% DEPLOYMENT\n    %% =========================\n    subgraph DEPLOY[\&quot;🐳 DEPLOYMENT\&quot;]\n        DOCKER[\&quot;🐳 Docker Container\&quot;]\n        LOCAL[\&quot;🌐 localhost:5000\&quot;]\n    end\n\n    %% =========================\n    %% CLIENT → FRONTEND\n    %% =========================\n    U --&gt; B\n    B --&gt; D\n\n    D --&gt; S\n    D --&gt; MS\n    D --&gt; W\n    D --&gt; A\n    D --&gt; FP\n\n    %% =========================\n    %% FRONTEND → BACKEND\n    %% =========================\n    S --&gt; API\n    MS --&gt; API\n    W --&gt; API\n    A --&gt; API\n    FP --&gt; API\n\n    API --&gt; FLASK\n\n    %% =========================\n    %% BACKEND → MASTER AGENT\n    %% =========================\n    FLASK --&gt; MA\n\n    %% =========================\n    %% MASTER → SPECIALIZED AGENTS\n    %% =========================\n    MA --&gt; TA\n    MA --&gt; NSA\n    MA --&gt; MLA\n    MA --&gt; FA\n\n    %% =========================\n    %% AGENTS → DATA SOURCES\n    %% =========================\n    TA --&gt; YF\n    NSA --&gt; GN\n\n    MLA --&gt; M\n    MLA --&gt; CSV\n\n    FA --&gt; TM\n\n    %% =========================\n    %% DEPLOYMENT\n    %% =========================\n    FLASK -. \&quot;deployed in\&quot; .-&gt; DOCKER\n    DOCKER --&gt; LOCAL\n\n    %% =========================\n    %% STYLING\n    %% =========================\n\n    classDef client fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#111827\n    classDef frontend fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#111827\n    classDef backend fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#111827\n    classDef agents fill:#CCFBF1,stroke:#0F766E,stroke-width:2px,color:#111827\n    classDef data fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px,color:#111827\n    classDef external fill:#FCE7F3,stroke:#DB2777,stroke-width:2px,color:#111827\n    classDef deployment fill:#CFFAFE,stroke:#0891B2,stroke-width:2px,color:#111827\n\n    class U,B client\n    class D,S,MS,W,A,FP frontend\n    class API,FLASK backend\n    class MA,TA,NSA,MLA,FA agents\n    class M,TM,CSV data\n    class YF,GN external\n    class DOCKER,LOCAL deployment\n\n    %% =========================\n    %% LINK STYLING\n    %% =========================\n\n    linkStyle default stroke:#475569,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="x8H0XKOP2yaDVODrStye-1">
